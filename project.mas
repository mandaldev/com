{
  name "com"
  author "Mandal Dev"
  desc "bunch of C++ common utils based on stdc++ and enchance stdc++"
  license "GPLv3"

  target {
    Com {
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/Mas/Value.cpp"
        "src/Xo/CommandLine.cpp"
        "src/Xo/exec.cpp"
        "src/Codecs/base16.cpp"
        "src/Codecs/utf8.cpp"
        "src/Date.cpp"
        "src/file.cpp"
        "src/Mab/serialize.cpp"
        "src/ThreadPool.cpp"
        "src/system.cpp"

        "src/Proc/load.cpp"
        "src/Proc/Mounts.cpp"
        "src/Proc/Stat.cpp"
        "src/Proc/CpuInfo.cpp"
        "src/Proc/MemInfo.cpp"
        "src/Proc/DiskStats.cpp"
        "src/Proc/filesystems.cpp"
        "src/Proc/devices.cpp"
        "src/Proc/Net.cpp"
        "src/Proc/Process.cpp"
      ]

      install [
        {
          dir "Com"
          headers [
            "src/memory.hpp"
            "src/string.hpp"
            "src/file.hpp"

            "src/base.hpp"
            "src/raii.hpp"
            "src/meta.hpp"

            "src/Flags.hpp"
            "src/Range.hpp"
            "src/Date.hpp"

            "src/log.hpp"

            "src/BytesView.hpp"

            "src/ThreadPool.hpp"

            "src/math.hpp"
            "src/varith.hpp"

            "src/system.hpp"
          ]
        }
        {
          dir "Com/Mas"
          headers [
            "src/Mas/Value.hpp"
            "src/Mas/serialize.hpp"
          ]
        }
        {
          dir "Com/Xo"
          headers [
            "src/Xo/CommandLine.hpp"
            "src/Xo/exec.hpp"
          ]
        }
        {
          dir "Com/Codecs"
          headers [
            "src/Codecs/base16.hpp"
            "src/Codecs/utf8.hpp"
          ]
        }
        {
          dir "Com/Mab"
          headers [
            "src/Mab/abi.hpp"
            "src/Mab/serialize.hpp"
          ]
        }
        {
          dir "Com/Proc"
          headers [
            "src/Proc/Mounts.hpp"
            "src/Proc/Stat.hpp"
            "src/Proc/CpuInfo.hpp"
            "src/Proc/MemInfo.hpp"
            "src/Proc/DiskStats.hpp"
            "src/Proc/filesystems.hpp"
            "src/Proc/devices.hpp"
            "src/Proc/Net.hpp"
            "src/Proc/Process.hpp"
          ]
        }
      ]
    }

    check {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "test/main.cpp"
        "test/string.cpp"
        "test/Codecs/base16.cpp"
        "test/Codecs/utf8.cpp"
        "test/Mas/serialize.cpp"
        "test/Mab/serialize.cpp"
        "test/Xo/exec.cpp"

        "test/Proc/mounts.cpp"
        "test/Proc/stat.cpp"
        "test/Proc/cpuinfo.cpp"
        "test/Proc/meminfo.cpp"
        "test/Proc/diskstats.cpp"
        "test/Proc/filesystems.cpp"
        "test/Proc/devices.cpp"
        "test/Proc/net.cpp"
        "test/Proc/process.cpp"

        "test/system.cpp"
      ]

      dep [
        "Com"
      ]

      explicit_install "true"
    }
  }
}
