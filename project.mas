{
  name "com"
  author "Mandal Dev"
  desc "bunch of C++ common utils based on stdc++ and enchance stdc++"
  license "GPLv3"

  target {
    Com {
      language "c++"
      std "c++17"
      type "lib"

      src [
        "src/Mas/Value.cpp"
        "src/Xo/CommandLine.cpp"
        "src/Xo/exec.cpp"
        "src/Codecs/base16.cpp"
        "src/Codecs/utf8.cpp"
        "src/Date.cpp"
        "src/file.cpp"
        "src/Mab/serialize.cpp"
        "src/ThreadPool.cpp"
      ]

      install [
        {
          dir "Com"
          headers [
            "src/memory.hpp"
            "src/string.hpp"
            "src/file.hpp"

            "src/base.hpp"
            "src/raii.hpp"
            "src/meta.hpp"

            "src/Flags.hpp"
            "src/Range.hpp"
            "src/Date.hpp"

            "src/log.hpp"

            "src/BytesView.hpp"

            "src/ThreadPool.hpp"

            "src/math.hpp"
            "src/varith.hpp"
          ]
        }
        {
          dir "Com/Mas"
          headers [
            "src/Mas/Value.hpp"
            "src/Mas/serialize.hpp"
          ]
        }
        {
          dir "Com/Xo"
          headers [
            "src/Xo/CommandLine.hpp"
            "src/Xo/exec.hpp"
          ]
        }
        {
          dir "Com/Codecs"
          headers [
            "src/Codecs/base16.hpp"
            "src/Codecs/utf8.hpp"
          ]
        }
        {
          dir "Com/Mab"
          headers [
            "src/Mab/abi.hpp"
            "src/Mab/serialize.hpp"
          ]
        }
      ]
    }

    check {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "test/main.cpp"
        "test/string.cpp"
        "test/Codecs/base16.cpp"
        "test/Codecs/utf8.cpp"
        "test/Mas/serialize.cpp"
        "test/Mab/serialize.cpp"
      ]

      dep [
        "Com"
      ]
    }
  }
}
